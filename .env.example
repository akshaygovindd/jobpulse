# Copy to .env (gitignored). Placeholders only — never commit real values.
# S3 bucket for local runs against AWS (Terraform output `data_bucket`); or use --local-dir instead.
JOBPULSE_BUCKET=jobpulse-data-<ACCOUNT_ID>
AWS_PROFILE=default
AWS_REGION=us-east-1
# MotherDuck token (P2). Placeholder only; the real value lives in .env and the GitHub `prod` environment secrets.
MOTHERDUCK_TOKEN=<MOTHERDUCK_TOKEN>
